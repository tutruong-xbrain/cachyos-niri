// ============================================================
// niri config — Acer Nitro 5 AN515-57
//   i5-11400H + Intel UHD (renderD129) + RTX 3060M (renderD128)
//   eDP-1 1920x1080@144  |  DP-2 2560x1440@144 (qua Intel)
// ============================================================

// --- Môi trường / hành vi chung ---------------------------------
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// --- Output ------------------------------------------------------
// Kiểm tra tên/mode thật sau khi vào niri:  niri msg outputs
output "eDP-1" {
    mode "1920x1080@144.003"
    scale 1.0
    position x=0 y=0
    // Panel laptop thường không có VRR -> để tắt cho an toàn
    // variable-refresh-rate
}

output "DP-2" {
    mode "2560x1440@143.998"
    scale 1.0
    position x=1920 y=0
    focus-at-startup
    // Màn ngoài 144Hz: bật VRR nếu hỗ trợ (niri msg outputs ghi "VRR: supported")
    variable-refresh-rate
}

// --- Ép compositor chạy trên Intel iGPU (tránh nóng/pin tụt) -----
// Intel = 00:02.0 -> renderD129 ; NVIDIA = 01:00.0 -> renderD128
// Nếu `ls -l /dev/dri/by-path/*-render` khác đi, sửa lại số ở đây.
debug {
    render-drm-device "/dev/dri/renderD129"
}

// --- Input -------------------------------------------------------
input {
    keyboard {
        xkb {
            layout "us"          // đổi thành "vn" nếu dùng Telex/VNI
            // options "ctrl:nocaps"
        }
        repeat-delay 250
        repeat-rate 40
        numlock
    }

    touchpad {
        tap
        dwt                      // disable-while-typing
        natural-scroll
        accel-speed 0.2
        accel-profile "adaptive"
        scroll-method "two-finger"
    }

    mouse {
        accel-speed 0.2
        accel-profile "adaptive"
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
    workspace-auto-back-and-forth
}

// --- Layout ------------------------------------------------------
layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        width 2
        active-color "#7fc8ff"
        inactive-color "#3a3a3a"
    }

    border {
        off
    }

    shadow {
        on
        softness 20
        spread 2
        offset x=0 y=4
        color "#00000060"
    }
}

// --- Phím tắt (kiểu Omarchy / Super) -----------------------------
binds {
    // Ứng dụng
    Mod+T { spawn "ghostty"; }            // nếu chưa có ghostty: "alacritty"
    Mod+D { spawn "fuzzel"; }
    Mod+B { spawn "firefox"; }
    Mod+E { spawn "nautilus"; }
    Mod+Shift+E { quit; }

    // Cửa sổ
    Mod+Q { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+Ctrl+Space { switch-focus-between-floating-and-tiling; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Plus { set-column-width "+10%"; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Di chuyển focus (vim-style)
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }

    // Di chuyển cửa sổ
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }

    // Workspace
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }

    // Monitor
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+J { focus-monitor-down; }
    Mod+Ctrl+K { focus-monitor-up; }

    // Overview / screenshot
    Mod+O { toggle-overview; }
    Print { screenshot; }
    Mod+Print { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    // Âm thanh / sáng
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86AudioPlay { spawn "playerctl" "play-pause"; }
    XF86AudioNext { spawn "playerctl" "next"; }
    XF86AudioPrev { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp { spawn "brightnessctl" "-c" "backlight" "set" "5%+"; }
    XF86MonBrightnessDown { spawn "brightnessctl" "-c" "backlight" "set" "5%-"; }

    // Khoá màn hình
    Mod+Escape { spawn "swaylock" "-f"; }
}

// --- Autostart ---------------------------------------------------
// Noctalia (bar + launcher + notification + lock + theme engine).
// Nếu không dùng Noctalia thì comment dòng này và bật waybar + mako bên dưới.
spawn-at-startup "noctalia"

spawn-at-startup "swaybg" "-i" "/home/tutruong/Pictures/wallpaper.jpg"
spawn-at-startup "xwayland-satellite"

// Clipboard history
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"

// Nếu KHÔNG dùng Noctalia:
// spawn-at-startup "waybar"
// spawn-at-startup "mako"

// Gnome keyring (lưu mật khẩu app)
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"

// --- Window rules ------------------------------------------------
// Terminal: đừng vẽ nền border (trong suốt đẹp hơn)
window-rule {
    match app-id="^(Alacritty|kitty|com\\.mitchellh\\.ghostty)$"
    draw-border-with-background false
}

// Bo góc nhẹ cho cửa sổ
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}
